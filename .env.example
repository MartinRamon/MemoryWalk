# Copia a .env y rellena la clave si quieres extracción con Grok.
# Sin clave, Viaj usa un heurístico sobre el pie de foto.

XAI_API_KEY=
XAI_MODEL=grok-4.3
PORT=8787

# Orígenes permitidos para CORS, separados por comas.
# Por defecto solo la app local (Vite dev :5173 y preview :4173).
# En producción pon aquí el dominio real, p. ej. https://viaj.tudominio.com
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Sidecar de transcripción de audio (Python + faster-whisper). Opcional:
# si no está en marcha, el ingestor cae a leer el pie de foto. Ver sidecar/README.md
# TRANSCRIBER_URL=http://127.0.0.1:8788
# TRANSCRIBER_DISABLED=1   # fuerza a ignorar la transcripción aunque el sidecar esté arriba
